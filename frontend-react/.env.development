# Mocks are ON by default in dev (M2 mock-first plan).
# To switch a domain to the real backend, override in your own .env.local, e.g.:
#   VITE_MOCKS=schedule        (partners is real, schedule still mocked)
#   VITE_MOCKS=               (everything real)
VITE_MOCKS=all
# VITE_MOCK_LATENCY=0          (set 0 to switch the fake 300-700ms delay off)
VITE_API_URL=http://localhost:3000
